<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.example.target" android:versionCode="7" android:versionName="2.1">
    <uses-sdk android:minSdkVersion="16" android:targetSdkVersion="23" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <permission android:name="com.example.target.WEAK" android:protectionLevel="normal" />
    <permission android:name="com.example.target.STRONG" android:protectionLevel="signature" />
    <application android:debuggable="true" android:allowBackup="false" android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/nsc">
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".DeepLinkActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="target" android:host="open" />
                <data android:scheme="https" android:host="example.com" android:port="8443" android:pathPrefix="/app" />
            </intent-filter>
        </activity>
        <activity android:name="com.example.target.internal.Secret" android:exported="false" />
        <activity-alias android:name=".Alias" android:targetActivity=".MainActivity" android:exported="true" />
        <service android:name=".SyncService" android:permission="com.example.target.WEAK">
            <intent-filter><action android:name="com.example.target.SYNC" /></intent-filter>
        </service>
        <receiver android:name=".BootReceiver" android:permission="com.example.target.STRONG" android:exported="true" />
        <receiver android:name=".Hidden" />
        <provider android:name=".DataProvider" android:authorities="com.example.target.data;com.example.target.alt" />
        <provider android:name=".ModernProvider" android:authorities="com.example.target.modern" android:exported="false" android:readPermission="com.example.target.WEAK" />
        <activity android:name=".NoDefault">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nodefault" />
            </intent-filter>
        </activity>
    </application>
</manifest>
