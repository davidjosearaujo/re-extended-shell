#!/usr/bin/env bash
# Install an XAPK/split-APK bundle (all splits + OBB data) on a device.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

DEVICE_SERIAL=""
TARGET_AVD=""
XAPK_FILE=""

usage() {
    cat <<EOF
Usage: xapk-installer [-s SERIAL | -n AVD_NAME] <file.xapk|file.zip>

Installs every APK in an XAPK/ZIP bundle with 'adb install-multiple', then
pushes its OBB data (if any) to /sdcard/Android/obb/.

Options:
  -s, --serial SERIAL  Device to install on (optional with a single device)
  -n, --name AVD_NAME  Running emulator to install on, by AVD name
  -h, --help           Show this help

Examples:
  xapk-installer -s R3CN80ABCDE game.xapk   # on a physical device
  xapk-installer -n Pixel_6_Pro game.zip    # on an emulator, by AVD name
  xapk-installer game.xapk                  # on the only connected device
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -s|--serial) re_need_arg "$1" "$#"; DEVICE_SERIAL="$2"; shift 2 ;;
        -n|--name)   re_need_arg "$1" "$#"; TARGET_AVD="$2"; shift 2 ;;
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        *)
            case "$1" in
                *.xapk|*.zip) ;;
                *) re_die "not a .xapk or .zip file: $1" ;;
            esac
            [ -z "$XAPK_FILE" ] || re_die "only one file at a time."
            XAPK_FILE="$1"; shift ;;
    esac
done
if [ -n "$DEVICE_SERIAL" ] && [ -n "$TARGET_AVD" ]; then
    re_die "pass only one of -s SERIAL or -n AVD_NAME."
fi

[ -n "$XAPK_FILE" ] || re_usage_error "missing <file.xapk|file.zip>."
[ -f "$XAPK_FILE" ] || re_die "file not found: $XAPK_FILE"

re_require unzip adb

# If an AVD name was provided, resolve it to a serial number (an emulator
# serial names the same emulator, so -n takes that too)
if [ -n "$TARGET_AVD" ]; then
    echo "Looking for the emulator running $TARGET_AVD..."
    LINE=$(re_match_emulator "$TARGET_AVD") \
        || re_die "could not find a running emulator with AVD name '$TARGET_AVD'."
    DEVICE_SERIAL=${LINE%% *}
    echo "Found ${LINE#* } on $DEVICE_SERIAL."
fi

# Check the device is available (or that exactly one is connected)
DEVICE_SERIAL=$(re_pick_device "xapk-installer -s" "$DEVICE_SERIAL") || exit 1
ADB_CMD=(adb -s "$DEVICE_SERIAL")

TMP_DIR=$(mktemp -d)
trap 'echo "Cleaning up temporary files..."; rm -rf "$TMP_DIR"' EXIT

echo "Extracting '$XAPK_FILE' to temporary directory..."
unzip -q "$XAPK_FILE" -d "$TMP_DIR" || re_die "failed to extract the archive."

re_find_apks "$TMP_DIR"
APK_FILES=(${RE_APKS[@]+"${RE_APKS[@]}"})

[ ${#APK_FILES[@]} -gt 0 ] || re_die "no APK files found inside the archive."

echo "Installing ${#APK_FILES[@]} APK(s) on $DEVICE_SERIAL (adb install-multiple)..."
"${ADB_CMD[@]}" install-multiple "${APK_FILES[@]}" || re_die "the installation failed."
echo "Installed on $DEVICE_SERIAL."

# Handle OBB Data
if [ -d "$TMP_DIR/Android/obb" ]; then
    echo "Pushing the OBB data to /sdcard/Android/obb/ on $DEVICE_SERIAL..."
    "${ADB_CMD[@]}" shell mkdir -p /sdcard/Android/obb/
    if "${ADB_CMD[@]}" push "$TMP_DIR/Android/obb/." /sdcard/Android/obb/; then
        echo "OBB data pushed."
    else
        re_warn "could not push some or all OBB files."
    fi
fi
