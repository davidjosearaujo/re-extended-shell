#!/usr/bin/env bash
# Undo 'launch-emulator -d' on a physical device.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

usage() {
    cat <<EOF
Usage: release-device [-s SERIAL] [--reboot]

Undoes 'launch-emulator -d', so a physical device works normally once
unplugged: closes scrcpy, clears the global HTTP proxy, removes the adb reverse
tunnel, stops frida-server and deletes the pushed files. The injected CA stays
trusted until the device reboots.

Options:
  -s, --serial SERIAL  Device to release (optional with a single device)
  --reboot             Also reboot the device, which drops the injected CA
  -h, --help           Show this help
EOF
}

REBOOT="" SERIAL=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -s|--serial) re_need_arg "$1" "$#"; SERIAL="$2"; shift 2 ;;
        --reboot) REBOOT=1; shift ;;
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        *)  re_unexpected_arg "$1" "name the device with -s SERIAL" ;;
    esac
done

re_require adb
SERIAL=$(re_pick_device --physical "release-device -s" "$SERIAL") || exit 1
ADB=(adb -s "$SERIAL")
echo "Releasing device: $SERIAL"

# Close the scrcpy window(s) mirroring this device
FOUND=""
for PID in $(pgrep -x scrcpy); do
    if re_proc_has_arg "$PID" "$SERIAL"; then
        kill "$PID" && FOUND=1
    fi
done
[ -n "$FOUND" ] && echo "Closed scrcpy."

echo "Clearing the global HTTP proxy and the adb reverse tunnel for port $RE_ZAP_PORT..."
re_zap_proxy_off "$SERIAL"

# frida-server (from the frida-server command) runs out of the pushed files
if [ -n "$("${ADB[@]}" shell "ls $RE_DEVICE_DIR/frida-server 2>/dev/null" | tr -d '\r')" ] \
        && ROOT=$(re_root_mode "$SERIAL"); then
    if [ -n "$(re_root_shell "$SERIAL" "$ROOT" "pidof frida-server" 2>/dev/null | tr -d '\r')" ]; then
        echo "Stopping frida-server..."
        re_root_shell "$SERIAL" "$ROOT" "kill \$(pidof frida-server)" >/dev/null 2>&1
    fi
fi

echo "Removing pushed CA and frida-server files..."
"${ADB[@]}" shell rm -rf "$RE_DEVICE_DIR"

if [ -n "$REBOOT" ]; then
    echo "Rebooting to drop the injected CA..."
    "${ADB[@]}" reboot
    echo "Device $SERIAL released and rebooting."
else
    echo "Device $SERIAL released. The injected CA stays trusted until the next reboot (use --reboot to drop it now)."
fi
