#!/usr/bin/env bash
# Shut down a running emulator by AVD name.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

usage() {
    cat <<EOF
Usage: kill-emulator [-f] <AVD_NAME|SERIAL>

Asks the emulator to shut down cleanly (adb emu kill). If it can't be reached
over adb, or doesn't exit within 15s, its process is terminated instead.
The emulator is named by its AVD name or by its 'emulator-NNNN' adb serial.

Options:
  -f, --force  Skip the clean shutdown and kill the process right away (SIGKILL)
  -h, --help   Show this help
EOF
}

# PIDs of the emulator process for exactly this AVD (not just a name prefix)
emulator_pids() {
    local RE
    RE=$(printf '%s' "$1" | sed 's/[][\.*^$+?(){}|/]/\\&/g')
    pgrep -f -- "qemu-system[^ ]* .*(-avd |@)$RE( |\$)"
}

FORCE="" AVD_NAME=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -f|--force) FORCE=1; shift ;;
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        *)  [ -z "$AVD_NAME" ] || re_die "only one AVD at a time."
            AVD_NAME="$1"; shift ;;
    esac
done

re_require adb

if [ -z "$AVD_NAME" ]; then
    RUNNING=$(re_running_emulators)
    re_usage_error "missing <AVD_NAME>." "${RUNNING:+Running emulators:
$(sed 's/^/  /' <<<"$RUNNING")}"
fi

# The argument names one running emulator either way round: its AVD name or
# its 'emulator-NNNN' serial. An emulator whose console is unreachable has no
# AVD name over adb ('?'), and one that adb doesn't know at all has no serial:
# either identifier alone is enough to shut it down.
TARGET="$AVD_NAME"
SERIAL="" AVD_NAME=""
# --read-only lets several emulators run one AVD, and then its name doesn't
# say which one to stop (nor do their processes: only adb tells them apart)
case "$TARGET" in
    emulator-*) ;;
    *)  DUPS=$(re_running_emulators | awk -v n="$TARGET" '$2 == n')
        if [ -n "$DUPS" ] && [ "$(wc -l <<<"$DUPS")" -gt 1 ]; then
            echo "Error: several emulators run $TARGET, so its name isn't enough: name the one to stop by its serial." >&2
            sed 's/^/  /' <<<"$DUPS" >&2
            exit 1
        fi ;;
esac
if LINE=$(re_match_emulator "$TARGET"); then
    SERIAL=${LINE%% *}
    NAME=${LINE#* }
    [ "$NAME" = "?" ] || AVD_NAME="$NAME"
else
    # Not in adb's list: still try the process, unless what we have is a serial
    case "$TARGET" in emulator-*) ;; *) AVD_NAME="$TARGET" ;; esac
fi
LABEL=${AVD_NAME:-${SERIAL:-$TARGET}}

PIDS=""
[ -z "$AVD_NAME" ] || PIDS=$(emulator_pids "$AVD_NAME")

# Their processes carry only the AVD name, so with several of them a kill by
# name would take down an emulator nobody named: go through adb instead
AMBIGUOUS=""
if [ -n "$PIDS" ] && [ "$(wc -l <<<"$PIDS")" -gt 1 ]; then
    [ -n "$SERIAL" ] || re_die "several processes run $TARGET and adb knows none of them: stop them by hand (see 'pgrep -af qemu-system')."
    AMBIGUOUS=1
    AVD_NAME=""   # the process list can't say which of them is $SERIAL
    PIDS=""
fi

if [ -z "$PIDS" ] && [ -z "$SERIAL" ]; then
    echo "Error: no running emulator found: $TARGET" >&2
    if re_avd_dir "$TARGET" >/dev/null; then
        echo "That AVD exists but isn't running." >&2
    elif [ "$(adb -s "$TARGET" get-state 2>/dev/null)" = "device" ]; then
        echo "$TARGET is a connected device, not an emulator (unplug it, or: release-device -s $TARGET)." >&2
    fi
    RUNNING=$(re_running_emulators)
    [ -z "$RUNNING" ] || { echo "Running emulators:" >&2; sed 's/^/  /' <<<"$RUNNING" >&2; }
    exit 1
fi

# True while the emulator is still up: its process if we can name the AVD,
# otherwise its presence in adb's device list
still_up() {
    if [ -n "$AVD_NAME" ]; then
        [ -n "$(emulator_pids "$AVD_NAME")" ]
    else
        [ "$(adb -s "$SERIAL" get-state 2>/dev/null)" = "device" ]
    fi
}

if [ -n "$FORCE" ]; then
    [ -z "$AMBIGUOUS" ] || re_die "several emulators run $LABEL and only adb can tell them apart, so --force can't pick $SERIAL's process: stop it without --force."
    [ -n "$PIDS" ] || re_die "found $LABEL on $SERIAL over adb but not its process, try without --force."
    echo "Force killing emulator: $LABEL (PID: ${PIDS//$'\n'/ })"
    # shellcheck disable=SC2086
    kill -9 $PIDS
    exit 0
fi

if [ -n "$SERIAL" ]; then
    echo "Shutting down emulator: $LABEL ($SERIAL)"
    adb -s "$SERIAL" emu kill >/dev/null 2>&1
else
    echo "Emulator $LABEL is not reachable over adb, terminating it (PID: ${PIDS//$'\n'/ })"
    # shellcheck disable=SC2086
    kill $PIDS
fi

for _ in $(seq 1 15); do
    still_up || { echo "Emulator $LABEL stopped."; exit 0; }
    sleep 1
done

PIDS=""
[ -z "$AVD_NAME" ] || PIDS=$(emulator_pids "$AVD_NAME")
if [ -z "$PIDS" ]; then
    re_die "$LABEL didn't shut down within 15s and its process can't be found; kill it by hand."
fi
echo "Emulator didn't exit within 15s, killing it (PID: ${PIDS//$'\n'/ })"
# shellcheck disable=SC2086
kill -9 $PIDS
