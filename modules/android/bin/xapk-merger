#!/usr/bin/env bash
# Merge XAPK/APKS splits (or a directory of split APKs) into a single signed APK.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

INPUT_FILE=""
OUTPUT_APK=""
APKEDITOR_JAR="${APKEDITOR_JAR:-}"   # only set if you want to force a specific jar
APKEDITOR_CMD=()
KEYSTORE=""
KS_PASS="android"
KS_ALIAS="androiddebugkey"
KEEP_OBB=1
SKIP_SIGN=0
PROVISION=0

usage() {
    echo "Usage: xapk-merger [-o <output.apk>] [-k <keystore> [-p <ks_pass>] [-a <alias>]] [-j <APKEditor.jar>] [--no-obb] <path_to_file.xapk | .zip | .apks | directory>"
    echo "       xapk-merger --provision    Download APKEditor, or update it to the latest release"
    echo ""
    echo "Examples:"
    echo "  xapk-merger game.xapk                              # -> ./game_merged.apk (debug-signed)"
    echo "  xapk-merger com.example.app-splits/                # A directory of split APKs (e.g. from apk-pull)"
    echo "  xapk-merger -o out/app.apk game.zip                # Custom output path"
    echo "  xapk-merger -k my.jks -p secret -a mykey game.xapk # Sign with your own keystore"
    echo "  xapk-merger -j ~/tools/APKEditor.jar game.xapk     # Force a specific APKEditor jar"
    echo "  xapk-merger --provision                            # Fetch/update APKEditor, then exit"
}

# Older versions downloaded APKEditor to ~/.local/share/apkeditor/, move it over
migrate_old_jar() {
    local OLD_JAR="$HOME/.local/share/apkeditor/APKEditor.jar"
    if [ ! -f "$RE_APKEDITOR_DL" ] && [ -f "$OLD_JAR" ]; then
        mkdir -p "$(dirname "$RE_APKEDITOR_DL")"
        mv "$OLD_JAR" "$RE_APKEDITOR_DL" && rmdir "$(dirname "$OLD_JAR")" 2>/dev/null
    fi
    return 0
}

# Downloads the latest APKEditor release to $RE_APKEDITOR_DL and records its tag
# in $RE_APKEDITOR_DL.version. With "update", skips the download when that tag
# is already the latest. A failed download leaves the current jar in place.
download_apkeditor() {
    local MODE="${1:-}" RELEASE TAG JAR_URL CURRENT=""
    re_require curl
    RELEASE=$(curl -fsSL https://api.github.com/repos/REAndroid/APKEditor/releases/latest) \
        || re_die "could not reach the GitHub API to find the latest APKEditor release."
    TAG=$(printf '%s\n' "$RELEASE" | grep -o '"tag_name": *"[^"]*"' | head -n 1 | sed 's/.*"\([^"]*\)"$/\1/')
    JAR_URL=$(printf '%s\n' "$RELEASE" | grep -o '"browser_download_url": *"[^"]*\.jar"' | head -n 1 \
        | sed 's/.*"\(https[^"]*\)"$/\1/')
    [ -n "$JAR_URL" ] || re_die "could not resolve the APKEditor download URL. Download it manually and pass -j <jar>."
    [ -f "$RE_APKEDITOR_DL.version" ] && CURRENT=$(cat "$RE_APKEDITOR_DL.version")
    if [ "$MODE" = update ] && [ -f "$RE_APKEDITOR_DL" ] && [ -n "$TAG" ] && [ "$TAG" = "$CURRENT" ]; then
        echo "APKEditor $TAG is already the latest release: $RE_APKEDITOR_DL"
        return 0
    fi
    echo "Downloading APKEditor ${TAG:-(latest release)}${CURRENT:+ (replacing $CURRENT)}..."
    re_download "$JAR_URL" "$RE_APKEDITOR_DL" --progress-bar || re_die "download failed."
    if [ -n "$TAG" ]; then echo "$TAG" >"$RE_APKEDITOR_DL.version"; else rm -f "$RE_APKEDITOR_DL.version"; fi
    echo "APKEditor ${TAG:+$TAG }saved to $RE_APKEDITOR_DL"
}

# Parse arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -o|--output)   re_need_arg "$1" "$#"; OUTPUT_APK="$2"; shift 2 ;;
        -k|--keystore) re_need_arg "$1" "$#"; KEYSTORE="$2"; shift 2 ;;
        -p|--ks-pass)  re_need_arg "$1" "$#"; KS_PASS="$2"; shift 2 ;;
        -a|--alias)    re_need_arg "$1" "$#"; KS_ALIAS="$2"; shift 2 ;;
        -j|--jar)      re_need_arg "$1" "$#"; APKEDITOR_JAR="$2"; shift 2 ;;
        --no-obb)      KEEP_OBB=0; shift ;;
        --provision)   PROVISION=1; shift ;;
        -h|--help)     usage; exit 0 ;;
        *)
            # Accepts .xapk, .zip, .apks and a directory of APKs
            if [[ -d "$1" || "$1" == *.xapk || "$1" == *.zip || "$1" == *.apks ]]; then
                INPUT_FILE="$1"
            else
                usage >&2
                re_die "Unknown parameter or invalid file extension: $1"
            fi
            shift
            ;;
    esac
done

# --provision: fetch or update the downloaded jar, then stop unless there's
# something to merge too
if [ "$PROVISION" -eq 1 ]; then
    migrate_old_jar
    download_apkeditor update
    if [ -n "$APKEDITOR_JAR" ]; then
        echo "Note: merges use $APKEDITOR_JAR (APKEDITOR_JAR or -j), not this download."
    elif command -v apkeditor >/dev/null 2>&1; then
        echo "Note: merges use $(command -v apkeditor) (on PATH), not this download."
    fi
    [ -n "$INPUT_FILE" ] || exit 0
fi

if [ -z "$INPUT_FILE" ]; then
    usage >&2
    re_die "please specify the path to a .xapk, .zip or .apks file, or a directory of APKs."
fi
[ -f "$INPUT_FILE" ] || [ -d "$INPUT_FILE" ] || re_die "file not found: $INPUT_FILE"

# Check dependencies
[ -d "$INPUT_FILE" ] || re_require unzip
re_find_build_tool apksigner >/dev/null || re_die "'apksigner' not found (PATH or \$ANDROID_HOME/build-tools)."

# Resolve APKEditor: -j <jar> > 'apkeditor' on PATH > download jar
if [ -n "$APKEDITOR_JAR" ]; then
    [ -f "$APKEDITOR_JAR" ] || re_die "jar not found: $APKEDITOR_JAR"
    re_require java
    APKEDITOR_CMD=(java -jar "$APKEDITOR_JAR")
elif command -v apkeditor >/dev/null 2>&1; then
    APKEDITOR_CMD=("$(command -v apkeditor)")
else
    re_require java
    migrate_old_jar
    if [ ! -f "$RE_APKEDITOR_DL" ]; then
        echo "APKEditor not found."
        download_apkeditor
    fi
    APKEDITOR_CMD=(java -jar "$RE_APKEDITOR_DL")
fi
echo "Using APKEditor: ${APKEDITOR_CMD[*]}"

# Default output name: <input>_merged.apk in current dir
if [ -z "$OUTPUT_APK" ]; then
    BASE=$(basename "$INPUT_FILE")
    [ -d "$INPUT_FILE" ] || BASE="${BASE%.*}"
    OUTPUT_APK="$PWD/${BASE}_merged.apk"
fi
mkdir -p "$(dirname "$OUTPUT_APK")"

# Create temp directory and ensure it gets cleaned up (even on failure/Ctrl+C)
TMP_DIR=$(mktemp -d)
trap 'echo "Cleaning up temporary files..."; rm -rf "$TMP_DIR"' EXIT
SPLITS_DIR="$TMP_DIR/splits"
mkdir -p "$SPLITS_DIR"

if [ -d "$INPUT_FILE" ]; then
    EXTRACT_DIR="$INPUT_FILE"   # already a directory of APKs, read it in place
else
    EXTRACT_DIR="$TMP_DIR/extracted"
    mkdir -p "$EXTRACT_DIR"
    echo "Extracting '$INPUT_FILE' to temporary directory..."
    # With --no-obb, don't unpack the (often multi-GB) OBB data just to ignore it
    UNZIP_ARGS=()
    [ "$KEEP_OBB" -eq 1 ] || UNZIP_ARGS+=(-x 'Android/obb/*')
    unzip -q "$INPUT_FILE" -d "$EXTRACT_DIR" ${UNZIP_ARGS[@]+"${UNZIP_ARGS[@]}"} || re_die "failed to extract archive."
fi

APK_FILES=()
while IFS= read -r -d $'\0'; do
    APK_FILES+=("$REPLY")
done < <(find "$EXTRACT_DIR" -type f -name "*.apk" -print0)

[ ${#APK_FILES[@]} -gt 0 ] || re_die "no APK files found in '$INPUT_FILE'."

if [ ${#APK_FILES[@]} -eq 1 ]; then
    echo "Only one APK found, nothing to merge. Copying it as-is (original signature kept)..."
    cp "${APK_FILES[@]:0:1}" "$OUTPUT_APK"
    SKIP_SIGN=1
else
    # Flatten splits into one dir (avoid name collisions from nested folders)
    i=0
    for APK in "${APK_FILES[@]}"; do
        i=$((i + 1))
        NAME=$(basename "$APK")
        [ -e "$SPLITS_DIR/$NAME" ] && NAME="${i}_${NAME}"
        # Hard link when possible: splits of big games add up to GBs
        ln "$APK" "$SPLITS_DIR/$NAME" 2>/dev/null || cp "$APK" "$SPLITS_DIR/$NAME"
    done

    echo "Found ${#APK_FILES[@]} APK(s). Merging with APKEditor..."
    "${APKEDITOR_CMD[@]}" m -i "$SPLITS_DIR" -o "$TMP_DIR/merged-unsigned.apk" || re_die "APK merge failed."
    [ -f "$TMP_DIR/merged-unsigned.apk" ] || re_die "APKEditor finished but no merged APK was produced."
fi

if [ "$SKIP_SIGN" -eq 0 ]; then
    re_sign_apk "$TMP_DIR/merged-unsigned.apk" "$OUTPUT_APK" "$KEYSTORE" "$KS_PASS" "$KS_ALIAS" || exit 1
fi

# Handle OBB Data (can't be embedded in an APK, so copy alongside)
if [ "$KEEP_OBB" -eq 1 ] && [ -d "$EXTRACT_DIR/Android/obb" ]; then
    OBB_OUT="${OUTPUT_APK%.apk}_obb"
    echo "OBB data found. Copying to '$OBB_OUT'..."
    rm -rf "$OBB_OUT"
    mkdir -p "$OBB_OUT"
    cp -R "$EXTRACT_DIR/Android/obb/." "$OBB_OUT/"
    echo "Push later with: adb push \"$OBB_OUT/.\" /sdcard/Android/obb/"
fi

echo "Merged APK: $OUTPUT_APK"
echo "Done!"
