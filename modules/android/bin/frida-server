#!/usr/bin/env bash
# Start the matching frida-server (the Florida anti-detection build by default) on a rooted device, optionally spawning an app with SSL unpinning.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

FRIDA_DIR="$RE_DATA_DIR/frida"
UNPIN_REPO="httptoolkit/frida-interception-and-unpinning"
UNPIN_REF="${RE_FRIDA_UNPIN_REF:-main}"
# Loaded in this order, config.js first (it defines what the others use)
UNPIN_SCRIPTS="${RE_FRIDA_UNPIN_SCRIPTS:-native-tls-hook.js android/android-proxy-override.js android/android-system-certificate-injection.js android/android-certificate-unpinning.js android/android-certificate-unpinning-fallback.js}"

usage() {
    cat <<EOF
Usage: frida-server [-s SERIAL | -n AVD_NAME] [--refresh] [--push-only] [--ssl-unpinning PACKAGE [-l SCRIPT]...]
       frida-server [-s SERIAL | -n AVD_NAME] --stop

Downloads the frida-server build matching this machine's 'frida --version' and
the device's CPU, pushes it and starts it as root. Does nothing if that version
is already running. Needs root (adb root, or su via Magisk/KernelSU).

By default it fetches the Florida anti-detection build, which hides from the
checks apps run, from thelok1s/florida-zygisk (rebuilt weekly against the latest
Frida); RE_FRIDA_SOURCE=frida uses the stock upstream build instead. To stay
hidden it's pushed and run under a random, persisted name (RE_FRIDA_NAME,
exported for the other commands) rather than "frida-server"; --refresh rotates
that name.

Options:
  -s, --serial SERIAL      Device to use (optional with a single device)
  -n, --name AVD_NAME      Running emulator to use, by AVD name. Either flag takes
                           either identifier: both name one running device
  --ssl-unpinning PACKAGE  Then spawn PACKAGE under Frida with HTTP Toolkit's
                           unpinning scripts: the app trusts your proxy's CA
                           despite certificate pinning, and goes through it (port
                           $RE_PROXY_PORT on this machine, CA in RE_PROXY_CERT).
                           Exit the Frida REPL (Ctrl+D) to detach.
  -l, --load SCRIPT        Extra Frida script to load after the unpinning ones
                           (repeatable, needs --ssl-unpinning)
  --push-only              Only put the binary on the device, don't start it
                           (launch-emulator does this)
  --refresh                Download frida-server and the unpinning scripts
                           again, and rotate the random on-device name
  --stop                   Kill frida-server on the device
  -h, --help               Show this help
EOF
}

SERIAL="" PACKAGE="" REFRESH="" STOP="" PUSH_ONLY="" EXTRA=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -s|--serial|-n|--name)
            re_need_arg "$1" "$#"
            [ -z "$SERIAL" ] || re_die "pass only one of -s SERIAL or -n AVD_NAME."
            SERIAL="$2"; shift 2 ;;
        --ssl-unpinning) re_need_arg "$1" "$#"; PACKAGE="$2"; shift 2 ;;
        -l|--load)
            re_need_arg "$1" "$#"
            [ -f "$2" ] || re_die "script not found: $2"
            EXTRA+=("$2"); shift 2 ;;
        --refresh) REFRESH=1; shift ;;
        --push-only) PUSH_ONLY=1; shift ;;
        --stop) STOP=1; shift ;;
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        *)  re_unexpected_arg "$1" ;;
    esac
done
[ "${#EXTRA[@]}" -eq 0 ] || [ -n "$PACKAGE" ] || re_die "-l/--load needs --ssl-unpinning PACKAGE."
[ -z "$STOP" ] || [ -z "$PACKAGE" ] || re_die "--stop and --ssl-unpinning don't go together."
[ -z "$PUSH_ONLY" ] || { [ -z "$STOP" ] && [ -z "$PACKAGE" ]; } || re_die "--push-only doesn't go with --stop or --ssl-unpinning."

re_require adb
SERIAL=$(re_pick_device "frida-server -s" "$SERIAL") || exit 1
ROOT=$(re_require_root "$SERIAL") || exit 1
# 'adb root' restarts adbd, and the device shows up as offline until it is back
adb -s "$SERIAL" wait-for-device

# --refresh rotates the random on-device name (unless you've pinned one, or are
# only stopping). The server is about to be renamed out from under us, so stop
# and delete the old one first, while we still know its name.
if [ -n "$REFRESH" ] && [ -z "$STOP" ] && { [ -z "${RE_FRIDA_NAME:-}" ] || [ -n "${_RE_FRIDA_NAME_AUTO:-}" ]; }; then
    OLD_NAME=$(re_frida_name)
    OLD_PIDS=$(re_root_shell "$SERIAL" "$ROOT" "pidof $OLD_NAME" 2>/dev/null | tr -d '\r')
    if [ -n "$OLD_PIDS" ]; then
        echo "Rotating the on-device name; stopping the current server ($OLD_NAME)..."
        re_root_shell "$SERIAL" "$ROOT" "kill $OLD_PIDS" >/dev/null 2>&1
    fi
    adb -s "$SERIAL" shell "rm -f '$RE_DEVICE_DIR/$OLD_NAME' '$RE_DEVICE_DIR/$OLD_NAME.version'" >/dev/null 2>&1
    re_frida_name_reset >/dev/null || re_die "could not write $RE_FRIDA_NAME_FILE."
fi

DEV_NAME=$(re_frida_name) || re_die "could not read or create $RE_FRIDA_NAME_FILE."
DEVICE_BIN="$RE_DEVICE_DIR/$DEV_NAME"
running_pids() {
    re_root_shell "$SERIAL" "$ROOT" "pidof $DEV_NAME" 2>/dev/null | tr -d '\r'
}
kill_server() {
    local PIDS
    PIDS=$(running_pids)
    [ -n "$PIDS" ] || return 0
    re_root_shell "$SERIAL" "$ROOT" "kill $PIDS" >/dev/null 2>&1
    for _ in $(seq 1 10); do
        [ -z "$(running_pids)" ] && return 0
        sleep 0.5
    done
    re_root_shell "$SERIAL" "$ROOT" "kill -9 $PIDS" >/dev/null 2>&1
}

if [ -n "$STOP" ]; then
    if [ -z "$(running_pids)" ]; then
        echo "frida-server is not running on $SERIAL."
    else
        kill_server
        echo "Stopped frida-server on $SERIAL."
    fi
    exit 0
fi

re_require frida
VERSION=$(frida --version 2>/dev/null | tr -d '\r')
[ -n "$VERSION" ] || re_die "could not read the version from 'frida --version'."

ABI=$(adb -s "$SERIAL" shell getprop ro.product.cpu.abi 2>/dev/null | tr -d '\r')
case "$ABI" in
    arm64-v8a)       ARCH=arm64 ;;
    armeabi-v7a|armeabi) ARCH=arm ;;
    x86_64)          ARCH=x86_64 ;;
    x86)             ARCH=x86 ;;
    *) re_die "unsupported device ABI '$ABI'." ;;
esac

# Which build to fetch. florida-zygisk is the Florida anti-detection build (the
# same frida patches), rebuilt weekly so it tracks current Frida versions;
# 'frida' is the stock upstream build. BUILD is the cache name, which carries
# the source and version even when the asset's own name doesn't. The Florida
# archive is gzip'd, Frida's xz'd.
case "$RE_FRIDA_SOURCE" in
    florida-zygisk) BUILD="florida-zygisk-server-$VERSION-android-$ARCH"
             BUILD_URL="https://github.com/thelok1s/florida-zygisk/releases/download/$VERSION/frida-server-android-$ARCH.gz"
             BUILD_EXT=gz
             SRC_RELEASES="https://github.com/thelok1s/florida-zygisk/releases" ;;
    frida)   BUILD="frida-server-$VERSION-android-$ARCH"
             BUILD_URL="https://github.com/frida/frida/releases/download/$VERSION/$BUILD.xz"
             BUILD_EXT=xz
             SRC_RELEASES="" ;;
    *) re_die "RE_FRIDA_SOURCE must be 'florida-zygisk' or 'frida', not '$RE_FRIDA_SOURCE'." ;;
esac

# Download (once per version, architecture and source) to the cache
LOCAL_BIN="$FRIDA_DIR/$BUILD"
if [ ! -f "$LOCAL_BIN" ] || [ -n "$REFRESH" ]; then
    echo "Downloading $BUILD..."
    trap 'rm -f "$LOCAL_BIN.$BUILD_EXT" "$LOCAL_BIN.part"' EXIT
    if ! re_download "$BUILD_URL" "$LOCAL_BIN.$BUILD_EXT" --progress-bar; then
        [ -z "$SRC_RELEASES" ] || re_die "$RE_FRIDA_SOURCE has no server build for Frida $VERSION (android-$ARCH).
It only tracks some Frida versions: $SRC_RELEASES
Install a frida-tools whose version it has (pipx install 'frida-tools==<version>'),
or set RE_FRIDA_SOURCE=frida to push the stock frida-server instead."
        re_die "download failed (is there a $VERSION release for android-$ARCH?)."
    fi
    # 'xz' isn't on stock macOS, but Python (which Frida needs) can unpack both
    re_decompress "$LOCAL_BIN.$BUILD_EXT" "$LOCAL_BIN.part" "$BUILD_EXT" \
        || re_die "could not decompress $BUILD.$BUILD_EXT ('xz'/'gzip' or python3 needed)."
    mv -f "$LOCAL_BIN.part" "$LOCAL_BIN"
    rm -f "$LOCAL_BIN.$BUILD_EXT"
    trap - EXIT
fi

# Push the binary, unless this very build (version and source) is already there.
# The marker is "<version> <source>", version first so re-doctor can read the
# version off the front without knowing the format.
DEVICE_MARKER=$(adb -s "$SERIAL" shell "[ -x '$DEVICE_BIN' ] && cat '$DEVICE_BIN.version'" 2>/dev/null | tr -d '\r')
DEVICE_VERSION=${DEVICE_MARKER%% *}
ON_DEVICE=""
if [ "$DEVICE_MARKER" = "$VERSION $RE_FRIDA_SOURCE" ] && [ -z "$REFRESH" ]; then ON_DEVICE=1; fi
# Anything running is stale unless this very build stays; the local test goes
# first so the common case saves a round trip to the device
if [ -z "$ON_DEVICE" ] && [ -n "$(running_pids)" ]; then
    echo "Stopping the frida-server already running on $SERIAL (${DEVICE_VERSION:-unknown version})..."
    kill_server
fi
if [ -z "$ON_DEVICE" ]; then
    echo "Pushing frida-server $VERSION ($ARCH, $RE_FRIDA_SOURCE) to $SERIAL:$DEVICE_BIN..."
    adb -s "$SERIAL" shell mkdir -p "$RE_DEVICE_DIR" || exit 1
    adb -s "$SERIAL" push "$LOCAL_BIN" "$DEVICE_BIN" >/dev/null || re_die "push failed."
    adb -s "$SERIAL" shell "chmod 755 '$DEVICE_BIN' && echo '$VERSION $RE_FRIDA_SOURCE' > '$DEVICE_BIN.version'" || exit 1
elif [ -n "$PUSH_ONLY" ]; then
    echo "frida-server $VERSION is already on $SERIAL:$DEVICE_BIN."
fi
if [ -n "$PUSH_ONLY" ]; then
    echo "Start it with: frida-server -s $SERIAL"
    exit 0
fi

# Start it, unless it's already running
if [ -n "$(running_pids)" ]; then
    echo "frida-server $VERSION is already running on $SERIAL."
else
    echo "Starting frida-server as root ($ROOT)..."
    # Redirect on the device: the daemon would otherwise keep adb's output
    # open, and 'adb shell' would never return
    re_root_shell "$SERIAL" "$ROOT" "$DEVICE_BIN -D </dev/null >/dev/null 2>&1" </dev/null >/dev/null 2>&1
    STARTED=""
    for _ in $(seq 1 20); do
        if [ -n "$(running_pids)" ]; then STARTED=1; break; fi
        sleep 0.5
    done
    [ -n "$STARTED" ] || re_die "frida-server did not start (try running '$DEVICE_BIN' in a root shell to see why)."
    echo "frida-server $VERSION running on $SERIAL."
fi

[ -n "$PACKAGE" ] || exit 0

# --- SSL unpinning -----------------------------------------------------------

re_require_package "$SERIAL" "$PACKAGE"

# HTTP Toolkit's scripts (AGPL-3.0) are downloaded, not shipped with this repo
SCRIPTS_DIR="$FRIDA_DIR/unpinning/$UNPIN_REF"
for SCRIPT in config.js $UNPIN_SCRIPTS; do
    if [ ! -f "$SCRIPTS_DIR/$SCRIPT" ] || [ -n "$REFRESH" ]; then
        echo "Downloading unpinning script $SCRIPT ($UNPIN_REF)..."
        re_download "https://raw.githubusercontent.com/$UNPIN_REPO/$UNPIN_REF/$SCRIPT" "$SCRIPTS_DIR/$SCRIPT" -sS \
            || re_die "could not download $SCRIPT from $UNPIN_REPO@$UNPIN_REF."
    fi
done

WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT
re_prepare_cert "$WORK_DIR"

# The emulator reaches this machine at 10.0.2.2; anything else gets the port
# tunnelled back over adb
PROXY_HOST=$(re_proxy_address "$SERIAL") || re_die "could not forward the device's port $RE_PROXY_PORT (adb reverse)."
PROXY_HOST=${PROXY_HOST%:*}
re_warn_proxy_down

# config.js with the proxy's CA and address filled in
CONFIG="$WORK_DIR/config.js"
awk -v pem="$RE_CERT_FILE" -v host="$PROXY_HOST" -v port="$RE_PROXY_PORT" -v q="'" '
    /^const CERT_PEM = `/ {
        cert = ""
        while ((getline line < pem) > 0) cert = cert (cert == "" ? "" : "\n") line
        print "const CERT_PEM = `" cert "`;"
        skip = 1
    }
    skip { if ($0 ~ /`;[[:space:]]*$/) skip = 0; next }
    /^const PROXY_HOST = / { print "const PROXY_HOST = " q host q ";"; next }
    /^const PROXY_PORT = / { print "const PROXY_PORT = " port ";"; next }
    { print }
' "$SCRIPTS_DIR/config.js" >"$CONFIG"
if ! grep -q -- '-----BEGIN CERTIFICATE-----' "$CONFIG" || grep -qF '[!! Put your CA certificate' "$CONFIG" \
        || ! grep -q "^const PROXY_PORT = $RE_PROXY_PORT;" "$CONFIG"; then
    re_die "could not fill in $SCRIPTS_DIR/config.js (its format changed?). Try --refresh, or pin RE_FRIDA_UNPIN_REF."
fi

LOADS=(-l "$CONFIG")
for SCRIPT in $UNPIN_SCRIPTS; do LOADS+=(-l "$SCRIPTS_DIR/$SCRIPT"); done
for SCRIPT in "${EXTRA[@]}"; do LOADS+=(-l "$SCRIPT"); done

echo "Spawning $PACKAGE with SSL unpinning (proxy $PROXY_HOST:$RE_PROXY_PORT). Exit the REPL to detach."
frida -D "$SERIAL" -f "$PACKAGE" "${LOADS[@]}"
