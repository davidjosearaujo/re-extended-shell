#!/usr/bin/env bash
# Boot an emulator (or set up a rooted phone) with ZAP's CA injected and its traffic proxied through ZAP.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

usage() {
    cat <<EOF
Usage: launch-emulator [--clean] [--start-frida-server | --no-frida] <AVD_NAME>
       launch-emulator -d [-s SERIAL] [--start-frida-server | --no-frida]

Boots the AVD from its '$RE_ZAP_SNAPSHOT' snapshot, or, when there is none yet,
does a wiped boot, sets up ZAP and saves the snapshot. Setting up ZAP means:
ZAP's root CA injected as a system CA, the global HTTP proxy pointed at ZAP,
and frida-server pushed (if Frida is installed here).
With -d, does the same on a rooted physical device (userdebug build, or su via
Magisk/KernelSU), proxying through 'adb reverse' and mirroring its screen with
scrcpy. Run release-device before unplugging it.
ZAP must listen on 127.0.0.1:$RE_ZAP_PORT, with its root CA exported to
$RE_ZAP_CERT.

Options:
  -d, --device          Use a connected physical device instead of an emulator
  -s, --serial SERIAL   Physical device to use (implies -d; optional with a
                        single device)
  --clean               Wiped boot that ignores the snapshot, then replaces it
  --start-frida-server  Also start frida-server (by default it's only pushed;
                        'frida-server' starts it later)
  --no-frida            Don't push frida-server
  -h, --help            Show this help
EOF
}

CLEAN="" DEVICE="" SERIAL="" AVD_NAME="" NO_FRIDA="" START_FRIDA=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        --clean) CLEAN=1; shift ;;
        --no-frida) NO_FRIDA=1; shift ;;
        --start-frida-server) START_FRIDA=1; shift ;;
        -d|--device) DEVICE=1; shift ;;
        -s|--serial) re_need_arg "$1" "$#"; DEVICE=1; SERIAL="$2"; shift 2 ;;
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        *)  [ -z "$AVD_NAME" ] || re_die "only one AVD at a time (a device serial goes after -s)."
            AVD_NAME="$1"; shift ;;
    esac
done

if [ -n "$NO_FRIDA" ] && [ -n "$START_FRIDA" ]; then
    re_die "--no-frida and --start-frida-server don't go together."
fi
if [ -n "$DEVICE" ] && [ -n "$AVD_NAME" ]; then
    re_die "pass either an AVD name or -d [-s SERIAL], not both (a device serial goes after -s)."
fi

re_require adb

# Fail early on a missing certificate, before booting anything
WORK_DIR=$(mktemp -d)
trap 'rm -rf "$WORK_DIR"' EXIT
re_prepare_cert "$WORK_DIR"

ADB=()
if [ -n "$DEVICE" ]; then
    [ -n "$CLEAN" ] && re_warn "--clean has no effect on a physical device, ignoring it."
    SERIAL=$(re_pick_device --physical "launch-emulator -d -s" "$SERIAL") || exit 1
    MODE="device"
    ADB=(adb -s "$SERIAL")
    MODEL=$("${ADB[@]}" shell getprop ro.product.model 2>/dev/null | tr -d '\r')
    echo "Using physical device: ${MODEL:-unknown model} ($SERIAL), skipping emulator launch."
else
    re_require emulator
    if [ -z "$AVD_NAME" ]; then
        AVDS=$(emulator -list-avds 2>/dev/null)
        PHYS=$(re_adb_devices --physical)
        re_usage_error "missing <AVD_NAME>, or -d for a physical device." \
            "${AVDS:+AVDs:
$(sed 's/^/  /' <<<"$AVDS")}${AVDS:+${PHYS:+
}}${PHYS:+Connected physical devices:
$(sed 's/^/  /' <<<"$PHYS")}"
    fi

    AVD_DIR=$(re_avd_dir "$AVD_NAME") || re_die "no AVD named '$AVD_NAME' (see 'emulator -list-avds')."

    # Decide the boot mode
    # (clean and create both boot wiped and save the snapshot afterwards)
    if [ -z "$CLEAN" ] && [ -d "$AVD_DIR/snapshots/$RE_ZAP_SNAPSHOT" ]; then
        MODE="snapshot"
        BOOT_ARGS=(-snapshot "$RE_ZAP_SNAPSHOT" -no-snapshot-save)
    else
        MODE="create"
        [ -z "$CLEAN" ] || MODE="clean"
        BOOT_ARGS=(-no-snapshot-load -no-snapshot-save -wipe-data)
    fi

    # Pick a free console/adb port pair so adb can target this emulator explicitly
    PORT=""
    for P in $(seq 5554 2 5584); do
        if ! re_port_listening "$P" && ! re_port_listening "$((P + 1))"; then PORT="$P"; break; fi
    done
    [ -n "$PORT" ] || re_die "no free emulator port pair between 5554 and 5585."
    SERIAL="emulator-$PORT"
    ADB=(adb -s "$SERIAL")
    EMU_LOG="${TMPDIR:-/tmp}/emulator-$AVD_NAME.log"

    case "$MODE" in
        clean)    echo "Starting forensic Android AVD: $AVD_NAME (wiped boot, snapshot ignored and rebuilt)" ;;
        snapshot) echo "Starting forensic Android AVD: $AVD_NAME (from snapshot '$RE_ZAP_SNAPSHOT')" ;;
        create)   echo "Starting forensic Android AVD: $AVD_NAME (no '$RE_ZAP_SNAPSHOT' snapshot, wiped boot, will create it)" ;;
    esac
    echo "Serial: $SERIAL, log: $EMU_LOG"

    emulator -avd "$AVD_NAME" \
             -port "$PORT" \
             "${BOOT_ARGS[@]}" \
             -netdelay none \
             -netspeed full </dev/null >"$EMU_LOG" 2>&1 &
    EMU_PID=$!
    disown

    echo "Waiting for Android boot to complete..."
    until re_boot_completed "$SERIAL"; do
        kill -0 "$EMU_PID" 2>/dev/null || re_die "emulator exited during boot. See $EMU_LOG"
        sleep 2
    done
fi

# Root: 'adb root' works on emulators and userdebug builds; rooted retail
# phones (Magisk/KernelSU) only offer su, which re_root_mode falls back to.
if ! ROOT=$(re_root_mode --adb-root "$SERIAL"); then
    if [ "$MODE" = "device" ]; then
        re_die "no root on $SERIAL (needs a userdebug build or a working su, e.g. Magisk/KernelSU)."
    else
        re_die "could not get a root adb shell (Google Play images don't allow it, use a Google APIs image)."
    fi
fi

# Runs in every mode: inject_ca.sh skips the injection if it's already in place
# (restored snapshot, or a device that hasn't rebooted since the last run)
echo "Pushing certificate ($RE_CERT_HASH.0) and CA injection script..."
"${ADB[@]}" shell mkdir -p "$RE_DEVICE_DIR" || exit 1
"${ADB[@]}" push "$RE_CERT_FILE" "$RE_ANDROID_DIR/device/inject_ca.sh" "$RE_DEVICE_DIR/" >/dev/null || exit 1
"${ADB[@]}" shell chmod 755 "$RE_DEVICE_DIR/inject_ca.sh"

echo "Executing CA injection script..."
re_root_shell "$SERIAL" "$ROOT" "$RE_DEVICE_DIR/inject_ca.sh $RE_DEVICE_DIR/$RE_CERT_HASH.0" \
    || re_die "the CA injection failed."

# A physical device gets the port tunnelled back to ZAP over adb reverse
[ "$MODE" != "device" ] || echo "Forwarding device port $RE_ZAP_PORT to this machine's ZAP (adb reverse)..."
PROXY=$(re_zap_proxy "$SERIAL") || re_die "could not forward port $RE_ZAP_PORT to ZAP (adb reverse)."
echo "Setting global HTTP proxy to $PROXY..."
"${ADB[@]}" shell settings put global http_proxy "$PROXY"

# By default only puts the binary on the device (start it with frida-server, or
# pass --start-frida-server). Runs before the snapshot is saved, so the binary
# ends up in it, but a started server doesn't: when asked to, it starts after.
# Best effort: the proxy and CA are already in place, so a failure only warns.
FRIDA_SERVER="$RE_ANDROID_DIR/bin/frida-server"
FRIDA_OK=""
if [ -z "$NO_FRIDA" ]; then
    if command -v frida >/dev/null 2>&1; then
        if "$FRIDA_SERVER" -s "$SERIAL" --push-only; then
            FRIDA_OK=1
        else
            re_warn "could not push frida-server, see above. Retry with: frida-server -s $SERIAL"
        fi
    else
        echo "Frida not found on this machine, not pushing frida-server (pip install frida-tools, or pass --no-frida to silence this)."
    fi
fi

if [ "$MODE" = "create" ] || [ "$MODE" = "clean" ]; then
    echo "Saving snapshot '$RE_ZAP_SNAPSHOT'..."
    if re_emu_snapshot "$SERIAL" save "$RE_ZAP_SNAPSHOT"; then
        echo "Snapshot '$RE_ZAP_SNAPSHOT' saved. Next launches will boot from it."
    else
        re_warn "failed to save snapshot '$RE_ZAP_SNAPSHOT'."
    fi
fi

if [ -n "$START_FRIDA" ] && [ -n "$FRIDA_OK" ]; then
    "$FRIDA_SERVER" -s "$SERIAL" || re_warn "frida-server did not start, see above. Retry with: frida-server -s $SERIAL"
fi

if [ "$MODE" = "device" ]; then
    if command -v scrcpy >/dev/null 2>&1; then
        SCRCPY_LOG="${TMPDIR:-/tmp}/scrcpy-${SERIAL//[^A-Za-z0-9._-]/_}.log"
        echo "Launching scrcpy (log: $SCRCPY_LOG)..."
        scrcpy -s "$SERIAL" --window-title "${MODEL:-$SERIAL} ($SERIAL)" </dev/null >"$SCRCPY_LOG" 2>&1 &
        disown
    else
        re_warn "scrcpy not found, skipping screen mirroring (https://github.com/Genymobile/scrcpy)."
    fi
    echo "$SERIAL is ready: its traffic goes to ZAP via $PROXY (adb reverse)."
    echo "The CA lasts until the device reboots. The proxy setting persists and breaks the device's"
    echo "network once adb disconnects, so run 'release-device -s $SERIAL' before unplugging it."
else
    echo "$SERIAL is ready: its traffic goes to ZAP via $PROXY."
fi
