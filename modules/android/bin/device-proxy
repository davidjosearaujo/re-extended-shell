#!/usr/bin/env bash
# Turn the HTTP proxy on or off on a running emulator or device.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

usage() {
    cat <<EOF
Usage: device-proxy [-s SERIAL] on|off|status

Switches the global HTTP proxy of a running emulator or device, pointing it at
your intercepting proxy (ZAP, Burp, mitmproxy, ...), without a restart or a
snapshot reset ('launch-emulator --proxy PORT --ca FILE' sets one up at boot).
'off' clears any global HTTP proxy, and on a physical device the adb reverse
tunnel that proxy goes through. On a physical device, run 'off' (or
release-device) before unplugging it.

Actions:
  on      Route the device's traffic to port $RE_PROXY_PORT on this machine: sets the
          global HTTP proxy, and for a physical device the adb reverse tunnel
  off     Clear the proxy (and the tunnel), so the device has normal network access
  status  Show the current proxy setting

Options:
  -s, --serial SERIAL  Device to use (optional with a single device)
  -h, --help           Show this help
EOF
}

ACTION="" SERIAL=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -s|--serial) re_need_arg "$1" "$#"; SERIAL="$2"; shift 2 ;;
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        on|off|status)
            [ -z "$ACTION" ] || re_die "only one of on, off, status."
            ACTION="$1"; shift ;;
        *)  re_unexpected_arg "$1" "name the device with -s SERIAL" ;;
    esac
done
[ -n "$ACTION" ] || re_usage_error "missing the action: on, off or status."

re_require adb
SERIAL=$(re_pick_device "device-proxy $ACTION -s" "$SERIAL") || exit 1

case "$ACTION" in
    on)
        PROXY=$(re_proxy_address "$SERIAL") || re_die "could not forward port $RE_PROXY_PORT (adb reverse)."
        adb -s "$SERIAL" shell settings put global http_proxy "$PROXY" || exit 1
        re_warn_proxy_down
        echo "$SERIAL: proxy on, traffic goes to port $RE_PROXY_PORT on this machine via $PROXY."
        case "$SERIAL" in emulator-*) ;; *) echo "Run 'device-proxy -s $SERIAL off' before unplugging it, or its network stops working." ;; esac
        ;;
    off)
        re_proxy_off "$SERIAL" || exit 1
        echo "$SERIAL: proxy off."
        ;;
    status)
        PROXY=$(re_device_proxy "$SERIAL")
        if [ -z "$PROXY" ]; then
            echo "$SERIAL: no proxy set."
        else
            echo "$SERIAL: proxy $PROXY."
            if re_proxy_tunnel_missing "$SERIAL" "$PROXY"; then
                echo "  Warning: no adb reverse tunnel for it, the device has no network. Run: device-proxy -s $SERIAL on"
            fi
        fi
        ;;
esac
