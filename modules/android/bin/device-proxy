#!/usr/bin/env bash
# Turn the ZAP proxy on or off on a running emulator or device.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

usage() {
    cat <<EOF
Usage: device-proxy on|off|status [SERIAL]
  on      Route the device's traffic through ZAP (port $RE_ZAP_PORT, RE_ZAP_PORT): sets the
          global HTTP proxy, and for a physical device the adb reverse tunnel.
  off     Clear the proxy (and the tunnel) so the device has normal network access.
  status  Show the current proxy setting.
  SERIAL can be omitted when only one device is connected. launch-emulator sets the
  proxy up at boot; this switches it later without a restart or a snapshot reset.
  On a physical device run 'off' (or release-device) before unplugging it.
EOF
}

ACTION="" SERIAL=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -*) re_die "Unknown option: $1" ;;
        on|off|status)
            [ -z "$ACTION" ] || re_die "only one of on, off, status."
            ACTION="$1"; shift ;;
        *)  [ -z "$SERIAL" ] || re_die "only one device at a time."; SERIAL="$1"; shift ;;
    esac
done
[ -n "$ACTION" ] || { usage >&2; exit 1; }

re_require adb
SERIAL=$(re_pick_device "device-proxy $ACTION" "$SERIAL") || exit 1

case "$ACTION" in
    on)
        PROXY=$(re_zap_proxy "$SERIAL") || re_die "could not forward port $RE_ZAP_PORT to ZAP (adb reverse)."
        adb -s "$SERIAL" shell settings put global http_proxy "$PROXY" || exit 1
        re_port_listening "$RE_ZAP_PORT" || echo "Warning: nothing listens on port $RE_ZAP_PORT, is ZAP running?"
        echo "$SERIAL: proxy on, traffic goes to ZAP via $PROXY."
        case "$SERIAL" in emulator-*) ;; *) echo "Run 'device-proxy off $SERIAL' before unplugging it, or its network stops working." ;; esac
        ;;
    off)
        re_zap_proxy_off "$SERIAL" || exit 1
        echo "$SERIAL: proxy off."
        ;;
    status)
        PROXY=$(re_device_proxy "$SERIAL")
        if [ -z "$PROXY" ]; then
            echo "$SERIAL: no proxy set."
        else
            echo "$SERIAL: proxy $PROXY."
            if re_proxy_tunnel_missing "$SERIAL" "$PROXY"; then
                echo "  Warning: no adb reverse tunnel for it, the device has no network. Run: device-proxy on $SERIAL"
            fi
        fi
        ;;
esac
