#!/usr/bin/env bash
# Put a running emulator back to its saved snapshot, without restarting it.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

usage() {
    echo "Usage: reset-emulator [SERIAL|AVD_NAME]"
    echo "  Loads the '$RE_ZAP_SNAPSHOT' snapshot into a running emulator (adb emu avd snapshot"
    echo "  load) and waits until it's usable again. Everything since the snapshot is dropped:"
    echo "  installed apps, app data, the proxy setting. The CA and frida-server are back as"
    echo "  they were when the snapshot was saved."
    echo "  With one emulator running it's picked for you; with several, name it by serial"
    echo "  (emulator-5554) or by AVD name."
}

TARGET=""
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        -*) re_die "Unknown option: $1" ;;
        *)  [ -z "$TARGET" ] || re_die "Only one emulator at a time."; TARGET="$1"; shift ;;
    esac
done

re_require adb

RUNNING=$(re_running_emulators)
[ -n "$RUNNING" ] || re_die "no running emulator (start one with: launch-emulator <AVD>)."

if [ -z "$TARGET" ]; then
    if [ "$(wc -l <<<"$RUNNING")" -gt 1 ]; then
        echo "Error: several emulators running, pick one with: reset-emulator <SERIAL|AVD_NAME>" >&2
        sed 's/^/  /' <<<"$RUNNING" >&2
        exit 1
    fi
    LINE=$RUNNING
else
    LINE=$(awk -v t="$TARGET" '$1 == t || $2 == t { print; exit }' <<<"$RUNNING")
    if [ -z "$LINE" ]; then
        echo "Error: no running emulator matches '$TARGET'. Running emulators:" >&2
        sed 's/^/  /' <<<"$RUNNING" >&2
        exit 1
    fi
fi
SERIAL=${LINE%% *}
NAME=${LINE#* }

# Check for the snapshot up front (skipped if the AVD can't be located here,
# then the emulator's own reply below decides)
if AVD_DIR=$(re_avd_dir "$NAME") && [ ! -d "$AVD_DIR/snapshots/$RE_ZAP_SNAPSHOT" ]; then
    echo "Error: $NAME has no '$RE_ZAP_SNAPSHOT' snapshot to reset to." >&2
    echo "Restart it so one gets saved:  kill-emulator $NAME  &&  launch-emulator $NAME" >&2
    exit 1
fi

echo "Resetting $NAME ($SERIAL) to snapshot '$RE_ZAP_SNAPSHOT'..."
OUT=$(adb -s "$SERIAL" emu avd snapshot load "$RE_ZAP_SNAPSHOT" 2>&1 | tr -d '\r') || true
if ! grep -qx "OK" <<<"$OUT"; then
    echo "Error: the emulator didn't load the snapshot:" >&2
    sed 's/^/  /' <<<"$OUT" >&2
    exit 1
fi

# adb can drop and reconnect while the state is restored
adb -s "$SERIAL" wait-for-device
for _ in $(seq 1 60); do
    if re_boot_completed "$SERIAL"; then
        echo "Emulator $NAME is back at snapshot '$RE_ZAP_SNAPSHOT'."
        exit 0
    fi
    sleep 1
done
re_die "$SERIAL didn't report boot completed within 60s after the reset."
