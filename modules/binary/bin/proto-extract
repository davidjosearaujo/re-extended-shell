#!/usr/bin/env bash
# Recover the .proto files compiled into binaries, APKs, dex files and Python modules.
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

usage() {
    cat <<EOF
Usage: proto-extract [-o DIR] [-f] [--all] <file | dir>...

Recovers the .proto files an app was built with, so its protobuf traffic can
be decoded with field names instead of numbers. Code generated by protoc for
the full protobuf runtime embeds every .proto file as a descriptor; this finds
them in native libraries and executables (C++, Go, Rust, ...), in dex files
(Java), in Python modules, and inside APK, JAR, AAR and other zip archives,
and writes them back as .proto source under their own paths.

Apps built with protobuf-lite (most Android apps) carry no descriptors, so
nothing is found in their dex files; their native libraries may still have
some.

Options:
  -o, --output DIR  Output directory (default: ./<first input's name>-protos/)
  -f, --force       Replace an existing output
  --all             Also keep google/protobuf/*.proto (the standard types)
  -h, --help        Show this help

Examples:
  proto-extract app.apk
  proto-extract libnative.so server-binary
  protoc --decode=acme.v1.Order -I app-protos acme/v1/order.proto < body.bin
EOF
}

OUTPUT="" FORCE="" ALL="" INPUTS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -o|--output) re_need_arg "$1" "$#"; OUTPUT="$2"; shift 2 ;;
        -f|--force) FORCE=1; shift ;;
        --all) ALL=1; shift ;;
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        *)  [ -e "$1" ] || re_die "file not found: $1"
            INPUTS+=("$1"); shift ;;
    esac
done
[ "${#INPUTS[@]}" -gt 0 ] || re_usage_error "missing <file | dir>."
re_require python3
if [ -z "$OUTPUT" ]; then
    BASE=$(basename -- "${INPUTS[0]%/}")
    OUTPUT="$PWD/${BASE%.*}-protos"
fi
OUTPUT=${OUTPUT%/}
re_refuse_existing "$FORCE" "$OUTPUT"
rm -rf -- "$OUTPUT"

echo "Looking for protobuf descriptors in ${INPUTS[*]}..."
REPORT=$(python3 -I "$RE_BINARY_DIR/libexec/protodesc.py" "$OUTPUT" "${ALL:-0}" "${INPUTS[@]}") \
    || re_die "the search failed (see above)."

# One line per file found: STATUS NAME SOURCE MESSAGES ENUMS SERVICES NOTE.
# Fails when nothing was written; otherwise ends with how to decode a message.
if ! awk -F'\t' -v warn="$RE_C_WARN" -v off="$RE_C_OFF" -v out="$OUTPUT" '
    function n(c, word) { return c " " word (c == 1 ? "" : "s") }
    $1 == "written" {
        if (!w++) { print ""; first = $2 }
        printf "  %s\n      %s, %s, %s, from %s%s\n", $2, n($4, "message"), n($5, "enum"), n($6, "service"), $3,
            ($7 ~ /incomplete/ ? ", " warn $7 off : ($7 != "" ? ", " $7 : ""))
    }
    $1 == "skipped" { s++ }
    END {
        print ""
        if (w) printf "%d .proto file%s recovered.", w, (w == 1 ? "" : "s")
        else printf "No .proto files recovered."
        if (s) printf " %d standard google/protobuf one%s skipped (--all keeps them).", s, (s == 1 ? "" : "s")
        print ""
        if (!w) exit 1
        print "Saved to " out "/"
        print "Decode a message with: protoc --decode=<package.Message> -I \"" out "\" " first " < body.bin"
    }' <<<"$REPORT"; then
    rm -rf -- "$OUTPUT"
    echo "No descriptors found: the code may use protobuf-lite, or no protobuf at all. Try 'protoc --decode_raw' on the traffic."
    exit 1
fi
