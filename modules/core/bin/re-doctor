#!/usr/bin/env bash
# Check that RE Extended Shell and each module's tools are set up correctly.
# Read-only: it never changes anything, on this machine or on a device.
_re_shell_home=${RE_EXT_HOME:-}   # set by re_extended_shell_main in your shell
# shellcheck source=../lib.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib.sh"

# Every module with checks (modules/<module>/doctor.sh), core aside: it always runs
ALL_MODULES=()
for _f in "$RE_EXT_HOME"/modules/*/doctor.sh; do
    _m=${_f%/doctor.sh}; _m=${_m##*/}
    [ "$_m" = core ] || ALL_MODULES+=("$_m")
done

usage() {
    cat <<EOF
Usage: re-doctor [MODULE...]

Checks the shell setup, the proxy's CA certificate and port, then each module's
tools, emulators and connected devices, and says how to fix what's missing.
Read-only. Exits non-zero if something required is missing.

Arguments:
  MODULE  Only check these modules: ${ALL_MODULES[*]} (default: all)

Options:
  -h, --help  Show this help
EOF
}

MODULES=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        *)
            if [ ! -f "$RE_EXT_HOME/modules/$1/doctor.sh" ] || [ "$1" = core ]; then
                re_die "no checks for a module '$1' (modules: ${ALL_MODULES[*]})."
            fi
            MODULES+=("$1"); shift ;;
    esac
done
[ "${#MODULES[@]}" -gt 0 ] || MODULES=("${ALL_MODULES[@]}")

# --- Output helpers, used by the modules' doctor.sh files --------------------

FAILS=0 WARNS=0

doc_section() { printf '\n%s%s%s\n' "$RE_C_BOLD" "$1" "$RE_C_OFF"; }
_doc_hint() { [ -z "${1:-}" ] || printf '      %s%s%s\n' "$RE_C_DIM" "$1" "$RE_C_OFF"; }
# doc_ok|doc_warn|doc_fail|doc_info MESSAGE [HINT]
doc_ok()   { printf '  %s✓%s %s\n' "$RE_C_OK" "$RE_C_OFF" "$1"; _doc_hint "${2:-}"; }
doc_warn() { WARNS=$((WARNS + 1)); printf '  %s!%s %s\n' "$RE_C_WARN" "$RE_C_OFF" "$1"; _doc_hint "${2:-}"; }
doc_fail() { FAILS=$((FAILS + 1)); printf '  %s✗%s %s\n' "$RE_C_FAIL" "$RE_C_OFF" "$1"; _doc_hint "${2:-}"; }
doc_info() { printf '  %s-%s %s\n' "$RE_C_DIM" "$RE_C_OFF" "$1"; _doc_hint "${2:-}"; }

# Reports whether a command is on PATH. Fails for required tools, warns for
# optional ones. Prints nothing else, so callers can add version details.
# Usage: doc_tool required|optional COMMAND "what needs it" ["how to get it"]
doc_tool() {
    local LEVEL="$1" CMD="$2" WHAT="$3" HINT="${4:-}" P
    if P=$(command -v "$CMD" 2>/dev/null); then
        doc_ok "$CMD ${RE_C_DIM}$P${RE_C_OFF}"
        return 0
    fi
    if [ "$LEVEL" = required ]; then
        doc_fail "$CMD not found, needed by $WHAT" "$HINT"
    else
        doc_warn "$CMD not found, needed by $WHAT" "$HINT"
    fi
    return 1
}


# --- Checks ------------------------------------------------------------------

# shellcheck source=../doctor.sh
. "$RE_EXT_HOME/modules/core/doctor.sh"
for MODULE in "${MODULES[@]}"; do
    # shellcheck disable=SC1090
    . "$RE_EXT_HOME/modules/$MODULE/doctor.sh"
done

echo
if [ "$FAILS" -gt 0 ]; then
    printf '%s%d problem(s)%s, %d warning(s).\n' "$RE_C_FAIL" "$FAILS" "$RE_C_OFF" "$WARNS"
    exit 1
elif [ "$WARNS" -gt 0 ]; then
    printf '%sNo problems%s, %d warning(s) (optional tools or settings).\n' "$RE_C_OK" "$RE_C_OFF" "$WARNS"
else
    printf '%sAll good.%s\n' "$RE_C_OK" "$RE_C_OFF"
fi
