#!/usr/bin/env bash
# Run Google's Android emulator container and connect adb to it.
# shellcheck source=../lib/common.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib/common.sh"

IMAGE="${RE_ANDROID_CONTAINER_IMAGE:-us-docker.pkg.dev/android-emulator-268719/images/30-google-x64}"
ENGINE="${RE_CONTAINER_ENGINE:-}"
NAME="android_container"

case "${1:-}" in
    -h|--help)
        echo "Usage: androidcontainer"
        echo "  Starts '$NAME' from $IMAGE"
        echo "  (RE_ANDROID_CONTAINER_IMAGE) with podman, or docker when podman is missing"
        echo "  (RE_CONTAINER_ENGINE), then connects adb to localhost:5555 as root."
        echo "  Stop it with: <podman|docker> stop $NAME"
        exit 0
        ;;
    "") ;;
    *) re_die "Unknown parameter: $1" ;;
esac

if [ -z "$ENGINE" ]; then
    for ENGINE in podman docker ""; do
        [ -n "$ENGINE" ] && command -v "$ENGINE" >/dev/null 2>&1 && break
    done
    [ -n "$ENGINE" ] || re_die "neither podman nor docker is installed."
fi
re_require "$ENGINE" adb
if [ "$RE_OS" != Linux ]; then
    # The image runs QEMU with KVM, which only Linux hosts provide (Docker
    # Desktop/podman machine on macOS run a VM without nested KVM)
    re_die "the Android emulator container needs KVM, so it only runs on Linux hosts. On $RE_OS use launch-emulator <AVD> instead."
fi
[ -r /dev/kvm ] || re_die "/dev/kvm is not available (KVM is required)."
[ -f "$HOME/.android/adbkey" ] || re_die "$HOME/.android/adbkey not found (run 'adb start-server' once to create it)."

echo "Launching container..."
"$ENGINE" run --detach --rm --name "$NAME" \
    -e ADBKEY="$(cat "$HOME/.android/adbkey")" \
    --device /dev/kvm \
    --publish 8554:8554/tcp --publish 5555:5555/tcp \
    "$IMAGE" >/dev/null || exit 1

echo "Waiting for adb to accept connections..."
CONNECTED=""
for _ in $(seq 1 30); do
    if adb connect localhost:5555 2>/dev/null | grep -qE '^(already )?connected'; then CONNECTED=1; break; fi
    sleep 2
done
[ -n "$CONNECTED" ] || re_die "could not connect adb to localhost:5555 after 60s (see '$ENGINE logs $NAME')."
adb -s localhost:5555 wait-for-device root
echo "ADB connected!"
