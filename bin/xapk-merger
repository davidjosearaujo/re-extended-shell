#!/usr/bin/env bash
# Merge XAPK/APKS splits into a single signed APK.
# shellcheck source=../lib/common.sh
_re_self=$0   # follow symlinks to find the repo (no 'readlink -f' on older macOS)
while [ -L "$_re_self" ]; do
    _re_link=$(readlink -- "$_re_self")
    case "$_re_link" in /*) _re_self=$_re_link ;; *) _re_self=$(dirname -- "$_re_self")/$_re_link ;; esac
done
. "$(dirname -- "$_re_self")/../lib/common.sh"

INPUT_FILE=""
OUTPUT_APK=""
APKEDITOR_JAR="${APKEDITOR_JAR:-}"   # only set if you want to force a specific jar
APKEDITOR_CMD=()
KEYSTORE=""
KS_PASS="android"
KS_ALIAS="androiddebugkey"
KEEP_OBB=1
SKIP_SIGN=0

usage() {
    echo "Usage: xapk-merger [-o <output.apk>] [-k <keystore> [-p <ks_pass>] [-a <alias>]] [-j <APKEditor.jar>] [--no-obb] <path_to_file.xapk | .zip | .apks>"
    echo ""
    echo "Examples:"
    echo "  xapk-merger game.xapk                              # -> ./game_merged.apk (debug-signed)"
    echo "  xapk-merger -o out/app.apk game.zip                # Custom output path"
    echo "  xapk-merger -k my.jks -p secret -a mykey game.xapk # Sign with your own keystore"
    echo "  xapk-merger -j ~/tools/APKEditor.jar game.xapk     # Force a specific APKEditor jar"
}

find_build_tool() {
    local tool="$1" sdk latest
    if command -v "$tool" >/dev/null 2>&1; then command -v "$tool"; return 0; fi
    for sdk in "$ANDROID_HOME" "$ANDROID_SDK_ROOT" "$HOME/Android/Sdk" "$HOME/Library/Android/sdk"; do
        [ -z "$sdk" ] && continue
        latest=$(ls -d "$sdk"/build-tools/*/ 2>/dev/null | sort -V | tail -n 1)
        if [ -n "$latest" ] && [ -x "${latest}${tool}" ]; then
            echo "${latest}${tool}"
            return 0
        fi
    done
    return 1
}

# Parse arguments
while [[ "$#" -gt 0 ]]; do
    case $1 in
        -o|--output)   OUTPUT_APK="$2"; shift 2 ;;
        -k|--keystore) KEYSTORE="$2"; shift 2 ;;
        -p|--ks-pass)  KS_PASS="$2"; shift 2 ;;
        -a|--alias)    KS_ALIAS="$2"; shift 2 ;;
        -j|--jar)      APKEDITOR_JAR="$2"; shift 2 ;;
        --no-obb)      KEEP_OBB=0; shift ;;
        -h|--help)     usage; exit 0 ;;
        *)
            # Accepts .xapk, .zip and .apks
            if [[ "$1" == *.xapk || "$1" == *.zip || "$1" == *.apks ]]; then
                INPUT_FILE="$1"
            else
                echo "Error: Unknown parameter or invalid file extension: $1"
                usage
                exit 1
            fi
            shift
            ;;
    esac
done

if [ -z "$INPUT_FILE" ]; then
    echo "Error: Please specify the path to a .xapk, .zip or .apks file."
    usage
    exit 1
fi

if [ ! -f "$INPUT_FILE" ]; then
    echo "Error: File not found: $INPUT_FILE"
    exit 1
fi

# Check dependencies
command -v unzip >/dev/null 2>&1 || { echo >&2 "Error: 'unzip' is required but not installed."; exit 1; }
APKSIGNER=$(find_build_tool apksigner) || { echo >&2 "Error: 'apksigner' not found (PATH or \$ANDROID_HOME/build-tools)."; exit 1; }
ZIPALIGN=$(find_build_tool zipalign) || ZIPALIGN=""

# Resolve APKEditor: -j <jar> > 'apkeditor' on PATH > download jar
if [ -n "$APKEDITOR_JAR" ]; then
    [ -f "$APKEDITOR_JAR" ] || { echo >&2 "Error: Jar not found: $APKEDITOR_JAR"; exit 1; }
    command -v java >/dev/null 2>&1 || { echo >&2 "Error: 'java' is required but not installed."; exit 1; }
    APKEDITOR_CMD=(java -jar "$APKEDITOR_JAR")
elif command -v apkeditor >/dev/null 2>&1; then
    APKEDITOR_CMD=("$(command -v apkeditor)")
else
    command -v java >/dev/null 2>&1 || { echo >&2 "Error: 'java' is required but not installed."; exit 1; }
    command -v curl >/dev/null 2>&1 || { echo >&2 "Error: 'apkeditor' not on PATH and 'curl' missing to download it (or pass -j <jar>)."; exit 1; }
    APKEDITOR_JAR="$HOME/.local/share/apkeditor/APKEditor.jar"
    if [ ! -f "$APKEDITOR_JAR" ]; then
        echo "APKEditor not found. Downloading latest release..."
        JAR_URL=$(curl -fsSL https://api.github.com/repos/REAndroid/APKEditor/releases/latest \
            | grep -o '"browser_download_url": *"[^"]*\.jar"' | head -n 1 \
            | sed 's/.*"\(https[^"]*\)"$/\1/')
        [ -n "$JAR_URL" ] || { echo "Error: Could not resolve APKEditor download URL. Download it manually and pass -j <jar>."; exit 1; }
        mkdir -p "$(dirname "$APKEDITOR_JAR")"
        curl -fL -o "$APKEDITOR_JAR" "$JAR_URL" || { rm -f "$APKEDITOR_JAR"; echo "Error: Download failed."; exit 1; }
    fi
    APKEDITOR_CMD=(java -jar "$APKEDITOR_JAR")
fi
echo "Using APKEditor: ${APKEDITOR_CMD[*]}"

# Default output name: <input>_merged.apk in current dir
if [ -z "$OUTPUT_APK" ]; then
    BASE=$(basename "$INPUT_FILE")
    OUTPUT_APK="$PWD/${BASE%.*}_merged.apk"
fi
mkdir -p "$(dirname "$OUTPUT_APK")"

# Create temp directory and ensure it gets cleaned up (even on failure/Ctrl+C)
TMP_DIR=$(mktemp -d)
trap 'echo "Cleaning up temporary files..."; rm -rf "$TMP_DIR"' EXIT
EXTRACT_DIR="$TMP_DIR/extracted"
SPLITS_DIR="$TMP_DIR/splits"
mkdir -p "$EXTRACT_DIR" "$SPLITS_DIR"

echo "Extracting '$INPUT_FILE' to temporary directory..."
unzip -q "$INPUT_FILE" -d "$EXTRACT_DIR" || { echo "Error: Failed to extract archive."; exit 1; }

APK_FILES=()
while IFS= read -r -d $'\0'; do
    APK_FILES+=("$REPLY")
done < <(find "$EXTRACT_DIR" -type f -name "*.apk" -print0)

if [ ${#APK_FILES[@]} -eq 0 ]; then
    echo "Error: No APK files found inside the archive."
    exit 1
fi

if [ ${#APK_FILES[@]} -eq 1 ]; then
    echo "Only one APK found, nothing to merge. Copying it as-is (original signature kept)..."
    cp "${APK_FILES[@]:0:1}" "$OUTPUT_APK"
    SKIP_SIGN=1
else
    # Flatten splits into one dir (avoid name collisions from nested folders)
    i=0
    for APK in "${APK_FILES[@]}"; do
        i=$((i + 1))
        NAME=$(basename "$APK")
        [ -e "$SPLITS_DIR/$NAME" ] && NAME="${i}_${NAME}"
        cp "$APK" "$SPLITS_DIR/$NAME"
    done

    echo "Found ${#APK_FILES[@]} APK(s). Merging with APKEditor..."
    if ! "${APKEDITOR_CMD[@]}" m -i "$SPLITS_DIR" -o "$TMP_DIR/merged-unsigned.apk"; then
        echo "APK merge failed."
        exit 1
    fi

    if [ ! -f "$TMP_DIR/merged-unsigned.apk" ]; then
        echo "Error: APKEditor finished but no merged APK was produced."
        exit 1
    fi
fi

if [ "$SKIP_SIGN" -eq 0 ]; then
    # zipalign MUST happen before apksigner (v2+ signatures cover the whole file)
    TO_SIGN="$TMP_DIR/merged-unsigned.apk"
    if [ -n "$ZIPALIGN" ]; then
        echo "Aligning APK..."
        if "$ZIPALIGN" -p -f 4 "$TO_SIGN" "$TMP_DIR/merged-aligned.apk"; then
            TO_SIGN="$TMP_DIR/merged-aligned.apk"
        else
            echo "Warning: zipalign failed, signing unaligned APK."
        fi
    else
        echo "Warning: 'zipalign' not found, skipping alignment."
    fi

    # Fall back to the Android debug keystore
    if [ -z "$KEYSTORE" ]; then
        KEYSTORE="$HOME/.android/debug.keystore"
        KS_PASS="android"
        KS_ALIAS="androiddebugkey"
        if [ ! -f "$KEYSTORE" ]; then
            command -v keytool >/dev/null 2>&1 || { echo >&2 "Error: 'keytool' is required to create a debug keystore."; exit 1; }
            echo "Creating debug keystore at $KEYSTORE..."
            mkdir -p "$HOME/.android"
            keytool -genkeypair -keystore "$KEYSTORE" -storepass android -keypass android \
                -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 \
                -dname "CN=Android Debug,O=Android,C=US" >/dev/null 2>&1 \
                || { echo "Error: Failed to create debug keystore."; exit 1; }
        fi
    fi

    echo "Signing with '$KEYSTORE' (alias: $KS_ALIAS)..."
    if ! "$APKSIGNER" sign --ks "$KEYSTORE" --ks-pass "pass:$KS_PASS" --ks-key-alias "$KS_ALIAS" \
            --v4-signing-enabled false --out "$OUTPUT_APK" "$TO_SIGN"; then
        echo "APK signing failed."
        exit 1
    fi

    if "$APKSIGNER" verify "$OUTPUT_APK" >/dev/null 2>&1; then
        echo "Signature verified."
    else
        echo "Warning: apksigner verify reported problems."
    fi
fi

# Handle OBB Data (can't be embedded in an APK, so copy alongside)
if [ "$KEEP_OBB" -eq 1 ] && [ -d "$EXTRACT_DIR/Android/obb" ]; then
    OBB_OUT="${OUTPUT_APK%.apk}_obb"
    echo "OBB data found. Copying to '$OBB_OUT'..."
    rm -rf "$OBB_OUT"
    mkdir -p "$OBB_OUT"
    cp -R "$EXTRACT_DIR/Android/obb/." "$OBB_OUT/"
    echo "Push later with: adb push \"$OBB_OUT/.\" /sdcard/Android/obb/"
fi

echo "Merged APK: $OUTPUT_APK"
echo "Done!"
