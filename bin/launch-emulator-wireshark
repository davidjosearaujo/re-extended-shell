#!/usr/bin/env bash
# Live capture of a device's traffic (tcpdump on the device) into Wireshark.
# shellcheck source=../lib/common.sh
. "$(dirname -- "$(readlink -f -- "$0")")/../lib/common.sh"

SERIAL="" IFACE="any"
while [ "$#" -gt 0 ]; do
    case "$1" in
        -s|--serial) SERIAL="$2"; shift 2 ;;
        -i|--interface) IFACE="$2"; shift 2 ;;
        -h|--help)
            echo "Usage: launch-emulator-wireshark [-s SERIAL] [-i INTERFACE]"
            echo "  Streams tcpdump from the device into a local Wireshark window."
            echo "  Needs root on the device (adb root, or su) and a tcpdump binary on it."
            echo "  -s, --serial     Device to capture from (optional with a single device)"
            echo "  -i, --interface  Device interface to capture on (default: any)"
            exit 0
            ;;
        *) re_die "Unknown parameter: $1" ;;
    esac
done

re_require adb wireshark
SERIAL=$(re_pick_device "launch-emulator-wireshark -s" "$SERIAL") || exit 1

adb -s "$SERIAL" shell command -v tcpdump >/dev/null 2>&1 \
    || re_die "no tcpdump binary on $SERIAL (push a static arm64/x86_64 build to /system/bin or /data/local/tmp)."

CAPTURE="tcpdump -i $IFACE -U -s 0 -w - 2>/dev/null"
if [ "$(adb -s "$SERIAL" shell id -u 2>/dev/null | tr -d '\r')" != "0" ]; then
    adb -s "$SERIAL" shell "su -c 'id -u'" 2>/dev/null | grep -q '^0' \
        || re_die "no root on $SERIAL (run 'adb root' on emulators/userdebug builds, or use a su-rooted device)."
    CAPTURE="su -c '$CAPTURE'"
fi

echo "Capturing '$IFACE' on $SERIAL into Wireshark (close Wireshark to stop)..."
adb -s "$SERIAL" exec-out "$CAPTURE" </dev/null | wireshark -k -i - >/dev/null 2>&1 &
disown
