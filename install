#!/usr/bin/env bash
# RE Extended Shell installer: hooks re_extended_shell_main into your shell's rc file.
# Safe to run again (after moving the repo, say): it updates the hook in place.
set -euo pipefail

REPO=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=lib/rc.sh
. "$REPO/lib/rc.sh"
# shellcheck source=modules/core/lib.sh
. "$REPO/modules/core/lib.sh"   # the help and error conventions every command shares
RE_CMD=./install

usage() {
    cat <<EOF
Usage: ./install [--bash] [--zsh]

Adds one line to ~/.bashrc and/or ~/.zshrc that sources:
  $MAIN
With no shell option it hooks every shell that has an rc file, plus your login
shell (\$SHELL), creating its rc file if needed. Safe to run again: it updates
the line in place. To remove it: ./uninstall

Options:
  --bash      Only ~/.bashrc (on macOS also makes sure ~/.bash_profile loads it)
  --zsh       Only \${ZDOTDIR:-\$HOME}/.zshrc
  -h, --help  Show this help
EOF
}

SHELLS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --bash) SHELLS+=(bash); shift ;;
        --zsh)  SHELLS+=(zsh); shift ;;
        -h|--help) re_help; exit 0 ;;
        -*) re_unknown_option "$1" ;;
        *)  re_unexpected_arg "$1" ;;
    esac
done

if [ "${#SHELLS[@]}" -eq 0 ]; then
    LOGIN_SHELL=$(basename -- "${SHELL:-}")
    for SH in bash zsh; do
        if [ -f "$(rc_for "$SH" | head -n 1)" ] || [ "$LOGIN_SHELL" = "$SH" ]; then
            SHELLS+=("$SH")
        fi
    done
    [ "${#SHELLS[@]}" -gt 0 ] || SHELLS=(bash)
fi

echo "Installing RE Extended Shell from $REPO:"
for SH in "${SHELLS[@]}"; do
    [ "$SH" = bash ] && ensure_bash_profile
    while IFS= read -r RC; do
        update_rc install "$RC"
    done < <(rc_for "$SH")
done
clean_legacy_profile

# Personal settings, never committed: local/<kind>.sh from local.example/.
# Existing files are never touched.
mkdir -p "$REPO/local"
for TEMPLATE in "$REPO"/local.example/*.sh; do
    [ -f "$TEMPLATE" ] || continue
    NAME=$(basename -- "$TEMPLATE")
    if [ ! -e "$REPO/local/$NAME" ]; then
        cp "$TEMPLATE" "$REPO/local/$NAME"
        echo "  Created local/$NAME (your settings)"
    fi
done

mkdir -p "$REPO/certs"
if [ ! -f "$REPO/certs/proxy_ca.cer" ] && [ ! -f "$REPO/certs/zap_root_ca.cer" ]; then
    echo
    echo "Optional: for frida-server --ssl-unpinning and apk-patch, export your intercepting"
    echo "proxy's root CA (ZAP, Burp, mitmproxy, ...; PEM or DER) to $REPO/certs/proxy_ca.cer,"
    echo "or point RE_PROXY_CERT at it in local/env.sh."
fi

echo
echo "Done. Open a new shell, or run: source $(rc_for "${SHELLS[0]}" | tail -n 1)"
