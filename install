#!/usr/bin/env bash
# RE Extended Bash installer: hooks re_extended_bash_main into your shell's rc file.
# Safe to run again (after moving the repo, say): it updates the hook in place.
set -euo pipefail

REPO=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
# shellcheck source=lib/rc.sh
. "$REPO/lib/rc.sh"

usage() {
    cat <<EOF
Usage: ./install [--bash] [--zsh]
  Adds one line to ~/.bashrc and/or ~/.zshrc that sources:
    $MAIN
  With no shell flag it hooks every shell that has an rc file, plus your login
  shell (\$SHELL), creating its rc file if needed.
  --bash  Only ~/.bashrc
  --zsh   Only \${ZDOTDIR:-\$HOME}/.zshrc
  To remove it again: ./uninstall
EOF
}

SHELLS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --bash) SHELLS+=(bash); shift ;;
        --zsh)  SHELLS+=(zsh); shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Error: Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done

if [ "${#SHELLS[@]}" -eq 0 ]; then
    LOGIN_SHELL=$(basename -- "${SHELL:-}")
    for SH in bash zsh; do
        if [ -f "$(rc_for "$SH")" ] || [ "$LOGIN_SHELL" = "$SH" ]; then
            SHELLS+=("$SH")
        fi
    done
    [ "${#SHELLS[@]}" -gt 0 ] || SHELLS=(bash)
fi

echo "Installing RE Extended Bash from $REPO:"
for SH in "${SHELLS[@]}"; do
    update_rc install "$(rc_for "$SH")"
done
clean_legacy_profile

# Personal overrides, never committed
if [ ! -d "$REPO/local" ]; then
    mkdir -p "$REPO/local"
    cp "$REPO"/local.example/*.sh "$REPO/local/"
    echo "Created local/ for your own settings (from local.example/)."
fi

mkdir -p "$REPO/certs"
if [ ! -f "$REPO/certs/zap_root_ca.cer" ]; then
    echo
    echo "Next: export ZAP's root CA so launch-emulator can inject it:"
    echo "  ZAP > Tools > Options > Network > Server Certificates > Save"
    echo "  (or: zap.sh -cmd -certpubdump $REPO/certs/zap_root_ca.cer)"
    echo "  and save it as $REPO/certs/zap_root_ca.cer"
fi

# shellcheck disable=SC2016  # expanded by the child bash
if ! /usr/bin/env bash -c '[ "${BASH_VERSINFO[0]}" -ge 4 ]'; then
    echo
    echo "Warning: the commands need bash 4 or newer, and 'bash' on your PATH is older"
    echo "(macOS ships 3.2). Install a newer one, e.g.: brew install bash"
fi

echo
echo "Done. Open a new shell, or run: source $(rc_for "${SHELLS[0]}")"
