#!/usr/bin/env bash
# RE Extended Shell uninstaller: removes the shell hook and, with --purge, the
# files the commands created outside this repo. Never deletes the repo itself.
set -euo pipefail

REPO=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

usage() {
    cat <<EOF
Usage: ./uninstall [--bash] [--zsh] [--purge]
  Removes the RE Extended Shell hook from ~/.bashrc and/or ~/.zshrc (every rc
  file that has it, unless a shell flag narrows it down).
  --bash   Only ~/.bashrc (and ~/.bash_profile, ~/.bash_login)
  --zsh    Only \${ZDOTDIR:-\$HOME}/.zshrc
  --purge  Also delete what the modules' commands created outside the repo
           (downloads, caches, emulator snapshots). Without it, they're listed.
  Your local/ settings and certs/ stay in $REPO;
  delete that directory to remove them too.
EOF
}

PURGE=""
SHELLS=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --bash) SHELLS+=(bash); shift ;;
        --zsh)  SHELLS+=(zsh); shift ;;
        --purge) PURGE=1; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Error: Unknown option: $1" >&2; usage >&2; exit 1 ;;
    esac
done
[ "${#SHELLS[@]}" -gt 0 ] || SHELLS=(bash zsh)   # missing rc files are skipped

# shellcheck source=lib/rc.sh
. "$REPO/lib/rc.sh"

echo "Uninstalling RE Extended Shell:"
for SH in "${SHELLS[@]}"; do
    while IFS= read -r RC; do
        update_rc uninstall "$RC"
    done < <(rc_for --all "$SH")
done
clean_legacy_profile

# Called by each module's purge.sh for every file or folder its commands left
# outside the repo: deletes it with --purge, otherwise notes it for the list.
LEFT=()
re_purge() {
    local TARGET="$1" LABEL="${2:-$1}"
    [ -e "$TARGET" ] || return 0
    if [ -n "$PURGE" ]; then
        rm -rf -- "$TARGET"
        echo "  Removed $LABEL"
    else
        LEFT+=("$LABEL")
    fi
}
for PURGE_FILE in "$REPO"/modules/*/purge.sh; do
    [ -f "$PURGE_FILE" ] || continue
    # shellcheck disable=SC1090
    . "$PURGE_FILE"
done
if [ "${#LEFT[@]}" -gt 0 ]; then
    echo
    echo "Left in place (run ./uninstall --purge to delete them):"
    printf '  %s\n' "${LEFT[@]}"
fi

echo
echo "Your settings (local/) and certificates (certs/) are still in $REPO."
echo "Delete that directory to remove RE Extended Shell completely."
echo "Done. Open a new shell to drop the setup."
